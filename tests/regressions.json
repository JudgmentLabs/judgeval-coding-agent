      "layers_only": "the row needs its own tracing.json, which the adapters' shared sandbox does not have"
    },
    {
      "id": "typed-default",
      "route": "output",
      "input": "password: str = \"<<alpha>>\"",
      "expect": "leaks",
      "limit": "value-stops"
    },
    {
      "id": "markdown-bold-name",
      "route": "output",
      "input": "**Password:** <<alpha>>\n**password**: <<opaque>>",
      "expect": "redacted"
    },
    {
      "id": "backticked-name",
      "route": "output",
      "input": "`password`: <<alpha>>",
      "expect": "redacted"
    },
    {
      "id": "stars-are-part-of-a-value",
      "route": "output",
      "input": "password=**None and token=**<<alpha>>",
      "expect": "redacted",
      "absent": [
        "**None"
      ]
    },
    {
      "id": "m-after-a-digit-is-no-boundary",
      "route": "output",
      "input": "model1mpassword_hint and 30mtoken_count",
      "expect": "unchanged"
    },
    {
      "id": "dotenv-contents",
      "route": "output",
      "input": "DATABASE_URL=postgres://app:<<opaque>>@db.internal:5432/app\nSTRIPE_SECRET=<<opaque2>>\nGITHUB_TOKEN=<<alpha>>\nDB_PASSWORD=\"<<phrase>>\"\nNODE_ENV=production",
      "expect": "redacted",
      "keep": [
        "DATABASE_URL=postgres://app:",
        "@db.internal:5432/app",
        "STRIPE_SECRET=",
        "GITHUB_TOKEN=",
        "DB_PASSWORD=",
        "NODE_ENV=production"
      ],
      "source": "a .env file read: its values go by name and format"
    },
    {
      "id": "dotenv-key-names",
      "route": "output",
      "input": "ENCRYPTION_KEY=<<opaque>>\nexport JWT_SIGNING_KEY='<<opaque2>>'\nKEY=<<alpha>>",
      "expect": "redacted",
      "keep": [
        "ENCRYPTION_KEY=",
        "export JWT_SIGNING_KEY='",
        "KEY="
      ]
    },
    {
      "id": "env-flag-key-name",
      "route": "command",
      "input": "docker run -e MASTER_KEY=<<opaque>> app",
      "output": "ok",
      "expect": "redacted",
      "keep": [
        "MASTER_KEY="
      ]
    },
    {
      "id": "key-names-not-env-form",
      "route": "output",
      "input": "sort_key=name\nPRIMARY_KEY = 1\nSSH_KEY_PATH=~/.ssh/id_ed25519\nMONKEY=banana",
      "expect": "unchanged"
    },
    {
      "id": "dotenv-cookie",
      "route": "output",
      "input": "SESSION_COOKIE=<<opaque>>",
      "expect": "leaks",
      "limit": "unnamed-value"
    },
    {
      "id": "redact-paths-hides-the-call",
      "route": "input",
      "input": {
        "file_path": "/app/.env"
      },
      "output": "SESSION_COOKIE=<<opaque>>",
      "cfg": {
        "redactPaths": [
          ".env*"
        ]
      },
      "layers_only": true,
      "expect": "redacted",
      "source": "the dotenv-cookie leak, closed by the project naming the file"
    },
    {
      "id": "redact-commands-hides-the-call",
      "route": "command",
      "input": "aws configure get aws_secret_access_key",
      "output": "<<opaque>>",
      "cfg": {
        "redactCommands": [
          "aws[^\\S\\n]+configure[^\\S\\n]+get"
        ]
      },
      "layers_only": true,
      "expect": "redacted",
      "source": "the aws-configure-get-secret leak, closed by the project naming the command"
    }
  ],
  "limits": [
    "code-after-name",
    "key-auth-unformatted",
    "reference-value",
    "space-separated",
    "unnamed-value",
    "value-stops"
  ]
}
