      },
      {
        "id": "secret_file",
        "globs": [
          "secret",
          "secrets",
          "Secret",
          "Secrets",
          "SECRET",
          "SECRETS",
          "secret.*",
          "secrets.*",
          "client_secret*.json",
          "*.tfvars",
          "!*.py",
          "!*.pyi",
          "!*.js",
          "!*.ts",
          "!*.tsx",
          "!*.jsx",
          "!*.go",
          "!*.rs",
          "!*.rb",
          "!*.java",
          "!*.kt",
          "!*.php",
          "!*.cs",
          "!*.swift",
          "!*.md",
          "!*.rst",
          "!*.c",
          "!*.h",
          "!*.cpp",
          "!*.hpp",
          "!*.html",
          "!*.css",
          "!*.scss",
          "!*.vue",
          "!*.svelte",
          "!*.sql",
          "!*.sh"
        ],
        "examples": [
          "secrets.yaml",
          "config/secret.json",
          "secrets",
          "prod.tfvars",
          "client_secret_123.apps.json",
          "SECRETS"
        ],
        "not": [
          "src/secrets.py",
          "lib/secret_manager.ts",
          "docs/secrets.md",
          "src/secrets.sh",
          "db/secrets.sql"
        ]
      },
      {
        "id": "auth_file",
        "globs": [
          ".netrc",
          "_netrc",
          ".npmrc",
          ".pypirc",
          ".git-credentials",
          ".pgpass",
          ".htpasswd",
          ".dockercfg",
          "auth.json",
          ".boto",
          ".s3cfg",
          ".vault-token",
          ".docker/config.json",
          ".kube/config",
          "kubeconfig"
        ],
        "examples": [
          ".netrc",
          ".npmrc",
          "~/.docker/config.json",
          "~/.kube/config",
          "kubeconfig"
        ],
        "not": [
          "src/config.json",
          "docs/netrc.md"
        ]
      },
      {
        "id": "proc_environ",
        "globs": [
          "proc/*/environ"
        ],
        "examples": [
          "/proc/self/environ"
        ],
        "not": [
          "/proc/self/status"
        ]
      }
    ],
    "commands": [
      {
        "id": "env_dump",
        "needs": [
          "env",
          "set",
          "export",
          "declare",
          "typeset"
        ],
        "re": [
          "(?:env|printenv|set|export(?:[^\\S\\n]+-p)?)[^\\S\\n]*(?=[0-9]{0,3}[<>]|[;&|\\n)`\"']|(?![\\s\\S]))",
          "(?:declare|typeset)[^\\S\\n]+-[A-Za-z]{0,8}[px][A-Za-z]{0,8}(?![A-Za-z0-9_-])"
        ],
        "examples": [
          "env",
          "printenv",
          "set",
          "export",
          "export -p",
          "declare -x",
          "declare -p FOO",
          "env | grep KEY",
          "env > out.txt"
        ],
        "not": [
          "env FOO=1 make",
          "set -e",
          "export FOO=1",
          "which env",
          "grep set README.md"
        ]
      },
      {
        "id": "printenv",
        "needs": [
          "printenv"
        ],
        "re": [
          "printenv(?![A-Za-z0-9_-])"
        ],
        "examples": [
          "printenv GITHUB_TOKEN"
        ],
        "not": [
          "printenv --help",
          "which printenv",
          "grep printenv README.md",
          "man printenv"
        ]
      },
      {
        "id": "secret_cli",
        "needs": [
          "gh",
          "aws",
          "kubectl",
          "gcloud",
          "op",
          "security",
          "vault",
          "heroku",
          "git",
          "az",
          "doppler",
          "pass",
          "bw"
        ],
        "re": [
          "gh[^\\S\\n]+auth[^\\S\\n]+token(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+configure[^\\S\\n]+(?:get|export-credentials)(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+sts[^\\S\\n]+(?:get-session-token|get-federation-token|assume-role(?:-with-saml|-with-web-identity)?)(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+(?:ecr|ecr-public)[^\\S\\n]+get-login-password(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+secretsmanager[^\\S\\n]+(?:get-secret-value|batch-get-secret-value)(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+ssm[^\\S\\n]+(?:get-parameters?|get-parameters-by-path)(?![A-Za-z0-9_-])",
          "aws[^\\S\\n]+codeartifact[^\\S\\n]+get-authorization-token(?![A-Za-z0-9_-])",
          "kubectl[^\\S\\n]+(?:get|describe)[^\\S\\n]+secrets?(?![A-Za-z0-9_-])",
          "gcloud[^\\S\\n]+auth[^\\S\\n]+(?:application-default[^\\S\\n]+)?(?:print-access-token|print-identity-token)(?![A-Za-z0-9_-])",
          "gcloud[^\\S\\n]+secrets[^\\S\\n]+versions[^\\S\\n]+access(?![A-Za-z0-9_-])",
          "az[^\\S\\n]+account[^\\S\\n]+get-access-token(?![A-Za-z0-9_-])",
          "az[^\\S\\n]+keyvault[^\\S\\n]+secret[^\\S\\n]+(?:show|download)(?![A-Za-z0-9_-])",
          "op[^\\S\\n]+(?:read|inject|item[^\\S\\n]+get)(?![A-Za-z0-9_-])",
          "security[^\\S\\n]+find-(?:generic|internet)-password(?![A-Za-z0-9_-])",
          "vault[^\\S\\n]+(?:read|kv[^\\S\\n]+get|print[^\\S\\n]+token)(?![A-Za-z0-9_-])",
          "heroku[^\\S\\n]+(?:config|auth:token)(?![A-Za-z0-9_-])",
          "git[^\\S\\n]+credential[^\\S\\n]+fill(?![A-Za-z0-9_-])",
          "doppler[^\\S\\n]+secrets(?![A-Za-z0-9_-])",
          "(?:pass|gopass)[^\\S\\n]+show(?![A-Za-z0-9_-])",
          "bw[^\\S\\n]+get(?![A-Za-z0-9_-])"
        ],
        "examples": [
          "gh auth token",
          "aws configure get aws_secret_access_key",
          "aws configure export-credentials --profile p",
          "kubectl get secret db -o yaml",
          "kubectl describe secrets",
          "gcloud auth print-access-token",
          "op read op://v/i/f",
          "op item get x --reveal",
          "security find-generic-password -w -s x",
          "vault kv get secret/x",
          "vault read secret/x",
          "heroku config",
          "aws secretsmanager get-secret-value --secret-id x",
          "git credential fill"
        ],
        "not": [
          "gh auth token --help",
          "gh auth status",
          "kubectl get pods",
          "aws s3 ls",
          "op --version",
          "which gh",
          "vault status",
          "grep 'gh auth token' notes.md"
        ]
      }
    ]
  },
  "fields": {
    "_comment": [
      "The class of each event field. A field not listed is text.",
      "strip: kept when an event loses its text (metadata capture at the hook, a sensitive event, a rule error, a blanked turn).",
      "redact: secrets in it are replaced. metadata: kept by metadata capture once transcripts were read.",
      "drop_when_blanked: dropped from the events a blanked turn's spans are built from, so a free-form name cannot become a span name."
    ],
    "classes": {
      "keep": {
        "strip": true,
        "redact": false,
        "metadata": true
      },
